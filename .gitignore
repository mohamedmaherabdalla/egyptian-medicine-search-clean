# Raw API-response logs are reproducible run artifacts. They total hundreds
# of megabytes and some exceed GitHub's per-file limit; compact row outcomes,
# summaries, manifests, and failure histories remain versioned.
algorithm_6_rule_evaluation/results/raw_responses.jsonl
algorithm_6_rule_evaluation/results/**/raw_responses.jsonl

